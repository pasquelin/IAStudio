{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/spike.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../../src/renderer/src/*"],
      "@game/*": ["../../src/game/*"],
      "@shared/*": ["../../src/shared/*"]
    }
  },
  "include": ["**/*.ts", "../../src/**/*.d.ts"]
}
