# Copier en `secrets/.env` et renseigner. Ce dossier est ignoré par git.
PROVIDER_API_KEY=
PROVIDER_API_SECRET=
# Nom du compte de développement dans le sélecteur. Vide : « Development ».
PROVIDER_ACCOUNT_NAME=Développement

# Signature et notarisation macOS. Vides : le build produit une application non signée.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
