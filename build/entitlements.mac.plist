<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      V8 compiles at runtime. `allow-unsigned-executable-memory` is not granted: modern V8 no
      longer needs W+X pages once JIT is allowed, and it is the widest hole in the hardened
      runtime after library validation.

      `disable-library-validation` is not granted either. @electron/osx-sign walks the whole
      bundle and signs every Mach-O it finds, including the .node modules under
      app.asar.unpacked — so better-sqlite3 carries our own Developer ID and validates.
      Add it back only if a specific module is observed to fail.

      No App Sandbox entitlements here: `com.apple.security.app-sandbox` is absent, as it must
      be for direct DMG distribution, which makes `network.client` and `files.user-selected`
      inert. Granting them would only suggest a confinement that does not exist.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
