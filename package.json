{
  "name": "scenario-studio",
  "productName": "Scenario Studio",
  "version": "0.1.0",
  "description": "Image, video, 3D, audio, texture and skybox creation on the Scenario API",
  "author": "Alban Pasquelin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "start": "electron-vite dev --watch",
    "start:debug": "electron-vite dev --watch --remoteDebuggingPort 9222",
    "build": "pnpm typecheck && electron-vite build && node scripts/check-artefact.mjs",
    "dist": "pnpm build && bash scripts/dist.sh",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "unused:main": "knip",
    "duplication": "jscpd",
    "lint": "eslint src --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write --cache \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check --cache \"src/**/*.{ts,tsx,css}\"",
    "check": "node scripts/check.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm coverage:slack",
    "coverage:slack": "node scripts/coverage-slack.mjs",
    "docs:scenario": "bash scripts/fetch-scenario-docs.sh",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "stt:fetch": "node scripts/fetch-stt.mjs",
    "licences:collect": "node scripts/collect-licences.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "decoders:copy": "node scripts/copy-decoders.mjs",
    "postinstall": "node scripts/dev-app-identity.mjs && node scripts/copy-decoders.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@scenario-labs/sdk": "^2.7.0",
    "@xyflow/react": "^12.11.3",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "mediabunny": "^1.53.1",
    "opentype.js": "^2.0.0",
    "pixi.js": "8.19.0",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "sherpa-onnx-node": "1.13.5",
    "three": "0.185.1",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-is": "^19.2.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "^5.7.16",
    "dockview-react": "^7.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.3.6",
    "immer": "^11.1.16",
    "jscpd": "^5.0.15",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-tooltip": "^6.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.14",
    "vitest": "^4.1.10",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
