{
  "name": "scenario-studio",
  "productName": "Scenario Studio",
  "version": "0.1.0",
  "description": "Studio de cr\u00e9ation d'images, vid\u00e9os, mod\u00e8les 3D, audio, textures et skyboxes sur l'API Scenario.",
  "author": "Alban Pasquelin",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite dev --watch",
    "start:debug": "electron-vite dev --watch --remoteDebuggingPort 9222",
    "build": "pnpm typecheck && electron-vite build",
    "dist": "pnpm build && bash scripts/dist.sh",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "docs:scenario": "bash scripts/fetch-scenario-docs.sh",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "node scripts/dev-app-identity.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@scenario-labs/sdk": "^2.7.0",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^11.0.2",
    "mediabunny": "^1.52.3",
    "pixi.js": "8.19.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "^5.7.16",
    "dockview-react": "^7.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.3.6",
    "immer": "^11.1.16",
    "jsdom": "^28.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "react-toastify": "^11.1.0",
    "react-tooltip": "^6.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.1.14",
    "vitest": "^4.1.10",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  }
}
